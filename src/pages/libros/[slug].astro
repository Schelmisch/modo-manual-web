---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import { libros } from '../../data/libros';
import { withBase } from '../../lib/url';
import { getCollection } from 'astro:content';
import { amazonUrl } from '../../lib/amazon';

export function getStaticPaths() {
  return libros.map((libro) => ({ params: { slug: libro.slug }, props: { libro } }));
}

import { sello } from '../../data/sello';

const { libro } = Astro.props;
const otros = libros.filter((l) => l.slug !== libro.slug && l.serie === libro.serie)
  .sort((a, b) => a.numero - b.numero);
const articulos = (await getCollection('blog', ({ data }) => !data.draft && data.libro === libro.slug))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Precio "4,99 €" → 4.99 (para las ofertas de schema.org).
const parsePrecio = (p: string) => Number(p.replace(/[^\d,]/g, '').replace(',', '.'));
const offers = (libro.precios ?? []).map((pr) => ({
  '@type': 'Offer',
  name: pr.formato,
  price: parsePrecio(pr.precio).toFixed(2),
  priceCurrency: 'EUR',
  availability: 'https://schema.org/InStock',
  ...(libro.amazon ? { url: amazonUrl(libro.amazon) } : {}),
}));

// Datos estructurados del libro (Google los usa para resultados enriquecidos).
const bookLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: libro.titulo,
  headline: `${libro.titulo}: ${libro.subtitulo}`,
  description: libro.sinopsis,
  inLanguage: 'es',
  author: { '@type': 'Person', name: sello.autor },
  publisher: { '@type': 'Organization', name: sello.nombre },
  image: new URL(withBase(libro.portada), Astro.site ?? sello.url).href,
  isPartOf: { '@type': 'BookSeries', name: libro.serie },
  ...(offers.length ? { offers } : {}),
};
---
<Base title={libro.titulo} description={libro.subtitulo} image={libro.portada} ogType="book" jsonLd={bookLd}>
  <section class="section">
    <div class="container" style="display:grid;grid-template-columns:minmax(0,280px) 1fr;gap:48px;align-items:start">
      <!-- Portada -->
      <div>
        <img src={withBase(libro.portada)} alt={`Portada de ${libro.titulo}`}
             style="width:100%;height:auto;aspect-ratio:2/3;object-fit:cover;border-radius:12px;border:1px solid var(--border);display:block"
             width="1500" height="2250" />
      </div>

      <!-- Ficha -->
      <div>
        <span class="kicker">{libro.serie} · Libro {libro.numero}</span>
        {libro.ancla && <span class="badge badge-ancla" style="margin-left:10px">Empieza aquí</span>}
        {libro.estado === 'proximamente' && <span class="badge badge-pronto" style="margin-left:10px">Próximamente</span>}
        <h1 style="margin-top:12px">{libro.titulo}</h1>
        <p class="lede">{libro.subtitulo}</p>
        <p>{libro.sinopsis}</p>

        <ul style="margin:20px 0;padding-left:20px">
          {libro.puntos.map((p) => <li style="color:var(--text-soft);margin-bottom:8px">{p}</li>)}
        </ul>

        {libro.precios && libro.estado === 'publicado' && (
          <ul class="formatos">
            {libro.precios.map((pr) => (
              <li>
                <span class="formato">{pr.formato}</span>
                <span class="precio">{pr.precio}</span>
              </li>
            ))}
          </ul>
        )}

        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:20px;align-items:center">
          {libro.estado === 'publicado' && libro.amazon && (
            <a class="btn btn-primary" href={withBase(`/go/comprar/${libro.slug}`)} target="_blank" rel="noopener">Comprar en Amazon</a>
          )}
          {libro.estado === 'publicado' && !libro.amazon && (
            <span class="btn btn-primary" style="opacity:0.6;cursor:default">Enlace de Amazon (pendiente de ASIN)</span>
          )}
          {libro.estado === 'proximamente' && (
            <a class="btn btn-primary" href={withBase('/newsletter')}>Avísame cuando salga</a>
          )}
        </div>
        {libro.estado === 'publicado' && (
          <p style="color:var(--text-dim);font-size:0.86rem;margin-top:14px">
            Los formatos comparten ficha en Amazon: elige el que prefieras allí.
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Sigue la serie -->
  {otros.length > 0 && (
    <section class="section section-soft">
      <div class="container">
        <span class="kicker">Sigue la serie</span>
        <h2>{libro.serie}</h2>
        <div class="grid-libros" style="margin-top:24px">
          {otros.map((l) => (
            <a class="libro-card" href={withBase(`/libros/${l.slug}`)}>
              <img src={withBase(l.portada)} alt={`Portada de ${l.titulo}`} loading="lazy" width="400" height="600" />
              <div class="card-body"><h3>{l.titulo}</h3><div class="sub">{l.subtitulo}</div></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {articulos.length > 0 && (
    <section class="section">
      <div class="container" style="max-width:760px">
        <span class="kicker">Del blog</span>
        <h2>Artículos que nacen de este libro</h2>
        <div style="margin-top:20px">
          {articulos.map((post) => (
            <article style="padding:18px 0;border-top:1px solid var(--border)">
              <h3 style="margin:0 0 6px;font-size:1.25rem"><a href={withBase(`/blog/${post.id}`)}>{post.data.title}</a></h3>
              <p style="margin:0">{post.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container" style="max-width:760px"><Newsletter /></div>
  </section>
</Base>
