---
import Base from '../../layouts/Base.astro';
import LibroRelacionado from '../../components/LibroRelacionado.astro';
import { getCollection, render } from 'astro:content';
import { withBase } from '../../lib/url';
import { sello } from '../../data/sello';
import { libros } from '../../data/libros';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const libroRel = post.data.libro ? libros.find((l) => l.slug === post.data.libro) : undefined;
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  inLanguage: 'es',
  author: { '@type': 'Person', name: sello.autor },
  publisher: { '@type': 'Organization', name: sello.nombre },
  mainEntityOfPage: new URL(withBase(`/blog/${post.id}`), Astro.site ?? sello.url).href,
};
---
<Base title={post.data.title} description={post.data.description} image={`/og/${post.id}.jpg`} ogType="article" jsonLd={articleLd}>
  <article class="section">
    <div class="container prose">
      <a href={withBase('/blog')} style="font-size:0.9rem">← Blog</a>
      <div style="font-size:0.82rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:0.08em;margin-top:20px">
        {fmt(post.data.pubDate)}
      </div>
      <h1 style="margin-top:8px">{post.data.title}</h1>
      <Content />
      {libroRel && <LibroRelacionado libro={libroRel} />}
    </div>
  </article>
</Base>
