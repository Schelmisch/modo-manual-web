---
import Base from '../layouts/Base.astro';
import LibroCard from '../components/LibroCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { libros, series } from '../data/libros';
import { withBase } from '../lib/url';
const porSerie = (nombre: string) => libros.filter((l) => l.serie === nombre).sort((a, b) => a.numero - b.numero);
---
<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="kicker">Sello editorial</span>
      <h1>No ficción <span class="lema">sin humo</span>.</h1>
      <p class="lede" style="max-width:640px">
        Datos, método y honestidad. Cero gurús, cero postureo, cero relleno.
        Libros que tratan al lector como adulto y le devuelven el mando: el <strong>modo manual</strong>.
      </p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px">
        <a class="btn btn-primary" href={withBase('/libros/modo-manual')}>Empieza por «Modo manual»</a>
        <a class="btn btn-ghost" href={withBase('/libros')}>Ver todos los libros</a>
      </div>
    </div>
  </section>

  <!-- SERIES -->
  {series.map((s, i) => (
    <section class={i % 2 === 0 ? 'section section-soft' : 'section'}>
      <div class="container">
        <span class="kicker">{i === 0 ? 'La serie' : 'Otra serie'}</span>
        <h2>{s.nombre}</h2>
        <p style="max-width:640px">{s.descripcion}</p>
        <div class="grid-libros" style="margin-top:32px">
          {porSerie(s.nombre).map((libro) => <LibroCard libro={libro} />)}
        </div>
      </div>
    </section>
  ))}

  <!-- PROMESA -->
  <section class="section">
    <div class="container" style="max-width:760px">
      <span class="kicker">La regla de la casa</span>
      <h2>Separar lo que se sabe de lo que se supone</h2>
      <p>
        Cuando un dato está medido, lo decimos, con su fuente. Cuando es una interpretación, también.
        Y cuando no se sabe —que pasa más de lo que a nadie le gusta reconocer—, lo decimos igual.
        Esa honestidad no es un adorno: es la única forma de no engañarse en medio del ruido.
      </p>
    </div>
  </section>

  <!-- SOBRE EL AUTOR -->
  <section class="section section-soft">
    <div class="container">
      <span class="kicker">Sobre el autor</span>
      <div class="autor">
        <img src={withBase('/autor/david-amigo.jpg')} alt="David Amigo, autor de la serie El cambio que viene"
             width="1254" height="1254" loading="lazy" />
        <div>
          <h2 style="margin-bottom:0.3em">David Amigo</h2>
          <p>
            David Amigo no se considera escritor. Es cocinero de profesión, 19 años de oficio,
            dueño de un restaurante. En sus libros es el director de la orquesta: el que decide
            qué preguntar, qué defender y qué sirve. La inteligencia artificial le ayuda a darles
            forma; el criterio, las decisiones y la última palabra son suyos. Es, literalmente,
            la tesis de estas páginas —el «modo manual»— puesta en práctica: la máquina como
            copiloto, nunca como piloto.
          </p>
          <p>
            Lleva tres años aprendiendo a usar la IA de verdad y construyendo cosas con ella:
            la fábrica de libros con la que nacen estos títulos, un software de gestión para
            hostelería (Nexus) y una app de moda en desarrollo. Desde esa doble silla —el que
            friega y el que decide— nace «El cambio que viene». Y es solo el principio: bajo el
            sello «Modo manual» aplicará el mismo método —separar lo que se sabe de lo que se
            supone— a cualquier tema que le pique la curiosidad.
          </p>
          <a class="btn btn-ghost" href={withBase('/libros')}>Ver todos sus libros</a>
        </div>
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="section">
    <div class="container" style="max-width:760px">
      <Newsletter />
    </div>
  </section>
</Base>
