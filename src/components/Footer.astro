---
import { sello } from '../data/sello';
import { withBase } from '../lib/url';
const year = 2026;
---
<footer class="site-footer">
  <div class="container">
    <p style="margin-bottom:8px;color:var(--text-soft)">
      <strong style="color:var(--text)">Modo manual</strong> — {sello.lema}
    </p>
    <p style="margin-bottom:16px">{sello.descripcion}</p>
    <p>
      <a href={withBase('/libros')}>Libros</a> · <a href={withBase('/blog')}>Blog</a> · <a href={withBase('/newsletter')}>Newsletter</a>
      · <a href={withBase('/aviso-legal')}>Aviso legal</a> · <a href={withBase('/privacidad')}>Privacidad</a>
    </p>
    <p style="margin-top:16px;color:var(--text-dim)">© {year} {sello.autor} · Sello Modo manual</p>
  </div>
</footer>
