---
import { sello, afiliados } from '../data/sello';
import { withBase } from '../lib/url';
const year = 2026;
---
<footer class="site-footer">
  <div class="container">
    <p style="margin-bottom:8px;color:var(--text-soft)">
      <strong style="color:var(--text)">Modo manual</strong> — {sello.lema}
    </p>
    <p style="margin-bottom:16px">{sello.descripcion}</p>
    <p>
      <a href={withBase('/libros')}>Libros</a> · <a href={withBase('/blog')}>Blog</a> · <a href={withBase('/newsletter')}>Newsletter</a>
      · <a href={withBase('/finanzas')}>Guía de finanzas</a>
      · <a href={withBase('/rss.xml')}>RSS</a>
      · <a href={withBase('/aviso-legal')}>Aviso legal</a> · <a href={withBase('/privacidad')}>Privacidad</a>
    </p>
    {afiliados.amazonTag && (
      <p style="margin-top:16px;color:var(--text-dim);font-size:0.82rem">
        Como Afiliado de Amazon, el sello obtiene ingresos por las compras adscritas que cumplen los requisitos.
        No cambia el precio que pagas.
      </p>
    )}
    <p style="margin-top:16px;color:var(--text-dim)">© {year} {sello.autor} · Sello Modo manual</p>
  </div>
</footer>
